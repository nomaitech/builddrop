[Unit]
Description=Android build server (builds APKs for the BuildDrop app)
After=network-online.target

[Service]
ExecStart=%h/.local/bin/builddrop-server -addr 0.0.0.0:8085
Environment=ANDROID_HOME=%h/Android/Sdk
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Restart=on-failure

[Install]
WantedBy=default.target
